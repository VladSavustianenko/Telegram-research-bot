{
  "name": "telegram-research-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Private-beta Telegram bot that runs scheduled and manual sourced web research.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:up": "docker compose up -d postgres postgres-test",
    "db:down": "docker compose down",
    "postinstall": "prisma generate",
    "ops:reconcile": "node dist/ops/reconcile-run.js",
    "ops:tool-telemetry": "node dist/ops/tool-telemetry.js",
    "ops:accounting": "node dist/ops/accounting.js",
    "ops:migrate": "node dist/ops/migrate.js",
    "ops:status": "node dist/ops/status.js",
    "ops:hold": "node dist/ops/hold.js",
    "ops:webhook": "node dist/ops/webhook.js",
    "ops:restore-quarantine": "node dist/ops/restore-quarantine.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "grammy": "1.46.0",
    "openai": "7.27.0",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "temporal-polyfill": "1.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pg-connection-string": "2.14.1",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
