# Copy to .env for local development. Never commit .env or real secrets.
# Empty values are treated as "not set".

# --- Foundation (TRB-010) ---------------------------------------------------
# development | test | production
NODE_ENV=development
# Railway injects PORT in production.
PORT=3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Local development database from docker-compose.yml (local-only credentials).
DATABASE_URL=postgresql://trb:trb@localhost:5434/trb_dev
# Database bounds (defaults shown): connection/pool acquisition, server-side
# statement timeout, and how long shutdown waits for in-flight work.
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_SHUTDOWN_TIMEOUT_MS=5000

# Disposable test server from docker-compose.yml (service postgres-test).
# Integration tests create and drop a uniquely named database on this server per run.
TEST_DATABASE_URL=postgresql://trb:trb@localhost:5433/postgres

# --- Telegram (TRB-020) ------------------------------------------------------
# disabled (default) | webhook (production) | polling (development only).
# Never run webhook and polling for the same bot token.
TELEGRAM_MODE=disabled
# Required unless TELEGRAM_MODE=disabled.
TELEGRAM_BOT_TOKEN=
# Required for TELEGRAM_MODE=webhook. 1-256 chars: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL used when registering the webhook (production).
PUBLIC_BASE_URL=
# Required unless TELEGRAM_MODE=disabled. Comma-separated numeric Telegram user IDs.
# Authoritative for the administrator role (docs/IDENTITY.md): applied at startup and on each
# update. Removing an ID revokes administrator rights; it never reactivates a suspended user.
ADMIN_TELEGRAM_IDS=
# Optional bot username without "@", for t.me invitation links (otherwise "/start <token>").
TELEGRAM_BOT_USERNAME=

# --- Invitations (TRB-030) -------------------------------------------------------
# Secret (at least 32 characters) from which invitation tokens are derived at send time;
# only token hashes are stored. Without it, /admin invite is refused. Rotating it
# invalidates invitations whose message has not been sent yet.
INVITATION_TOKEN_SECRET=
# Invitation lifetime in hours (default 168 = 7 days, at most 720).
INVITATION_TTL_HOURS=168

# --- Research (TRB-020) ------------------------------------------------------
# disabled (default): /research is refused.
# fake: simulated results labelled "СИМУЛЯЦІЯ"; no OpenAI call, no cost.
# live: paid OpenAI web research. Operator opt-in; requires the OpenAI and bound settings below.
RESEARCH_MODE=disabled
# Task limits (TRB-040; SPEC proposals). Paused tasks count as saved, not active.
TASK_ACTIVE_LIMIT=5
TASK_SAVED_LIMIT=20
# Fallback time zone for interpreting dates (IANA name); runs use the user's confirmed zone.
RESEARCH_TIME_ZONE=Europe/Kyiv
RESEARCH_PROMPT_MAX_CHARS=8000
# Maximum QUEUED + RUNNING runs; further /research requests are rejected.
RESEARCH_QUEUE_LIMIT=3
# In-process database-backed workers (research, delivery, polling): on | off.
BACKGROUND_WORKERS=on
WORKER_POLL_INTERVAL_MS=2000
OPENAI_POLL_INTERVAL_MS=3000

# --- OpenAI (required when RESEARCH_MODE=live) -----------------------------------
OPENAI_API_KEY=
# No default. The operator must select a model that supports the web_search tool.
OPENAI_MODEL=
# Optional: none | low | medium | high | xhigh. Only sent when set ("minimal" is rejected).
OPENAI_REASONING_EFFORT=
# Timeout of each HTTP call to OpenAI (not the run deadline). SDK retries are disabled.
OPENAI_HTTP_TIMEOUT_MS=30000

# --- Run bounds (required when RESEARCH_MODE=live; enforced in TRB-020) -------------
# Wall-clock deadline per run, at most 540 (provider background retention window).
RUN_DEADLINE_SECONDS=
# max_output_tokens (includes reasoning tokens), at least 16.
OUTPUT_TOKEN_LIMIT=
# max_tool_calls (built-in tool calls such as web searches), at least 1.
TOOL_CALL_LIMIT=
# Must be 1 if set: the prototype runs one research request globally.
RESEARCH_CONCURRENCY=

# --- Budgets (parsed but NOT enforced before TRB-050) ---------------------------
# USD amounts, at most 6 decimal places. No dollar cap is enforced by TRB-020.
# For live tests, set an OpenAI project hard spend limit with "Enforce a hard limit" turned on
# (spend alerts only notify). See docs/RESEARCH_SLICE.md.
USER_MONTHLY_BUDGET_USD=
GLOBAL_MONTHLY_BUDGET_USD=
RUN_MAX_ESTIMATED_COST_USD=
