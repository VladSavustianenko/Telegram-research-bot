# Copy to .env for local development. Never commit .env or real secrets.
# Empty values are treated as "not set".

# --- Foundation (TRB-010) ---------------------------------------------------
# development | test | production
NODE_ENV=development
# Railway injects PORT in production.
PORT=3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Local development database from docker-compose.yml (local-only credentials).
DATABASE_URL=postgresql://trb:trb@localhost:5434/trb_dev

# Disposable test server from docker-compose.yml (service postgres-test).
# Integration tests create and drop a uniquely named database on this server per run.
TEST_DATABASE_URL=postgresql://trb:trb@localhost:5433/postgres

# --- Telegram (required from TRB-020) ---------------------------------------
TELEGRAM_BOT_TOKEN=
# 1-256 chars: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL for the webhook (production).
PUBLIC_BASE_URL=
# Comma-separated numeric Telegram user IDs of bootstrap administrators.
ADMIN_TELEGRAM_IDS=

# --- OpenAI (required from TRB-020) -----------------------------------------
OPENAI_API_KEY=
# No default. The operator must select an available search-capable model.
OPENAI_MODEL=

# --- Budgets and run bounds (required for paid research) --------------------
# USD amounts, at most 6 decimal places. Paid research fails closed when missing.
USER_MONTHLY_BUDGET_USD=
GLOBAL_MONTHLY_BUDGET_USD=
RUN_MAX_ESTIMATED_COST_USD=
RESEARCH_CONCURRENCY=
RUN_DEADLINE_SECONDS=
OUTPUT_TOKEN_LIMIT=
TOOL_CALL_LIMIT=
