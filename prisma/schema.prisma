// Application schema. Prisma owns the `public` schema; pg-boss owns its own
// schema (QUEUE_SCHEMA, default `pgboss`; TRB-060), which the application
// installs at startup and Prisma migrations never manage (docs/QUEUE.md).

// moduleFormat and importFileExtension are explicit so that generation does not
// depend on whether tsconfig.json is present (e.g. during `npm ci` in Docker).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// TRB-020 prototype slice: inbound update deduplication, research runs and
// Telegram delivery progress. Constraints Prisma cannot express (partial
// unique indexes) are added in the SQL migration.

enum TelegramUpdateDisposition {
  RUN_ACCEPTED
  RESULT_REQUESTED
  REPLIED
  REJECTED
  IGNORED
}

/// One row per Telegram update_id; inserting it is the deduplication step.
/// Stores no message text.
model TelegramUpdate {
  updateId         BigInt                    @id @map("update_id")
  senderTelegramId BigInt?                   @map("sender_telegram_id")
  chatType         String?                   @map("chat_type")
  disposition      TelegramUpdateDisposition
  reason           String?
  runId            String?                   @map("run_id") @db.Uuid
  receivedAt       DateTime                  @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("telegram_update")
}

enum ResearchRunState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  UNCERTAIN
  /// Stopped by the application (suspension, eligibility); before submission no provider request exists.
  CANCELLED
}

/// Whether a (potentially billed) provider request may exist for this run.
enum SubmissionState {
  NOT_SUBMITTED
  SUBMITTING
  SUBMITTED
}

enum ResearchOutcome {
  FOUND
  PARTIAL
  NO_MATCHES
  INCONCLUSIVE
}

model ResearchRun {
  id                        String           @id @default(uuid()) @db.Uuid
  requestedByTelegramUserId BigInt           @map("requested_by_telegram_user_id")
  /// Owner. Null only for TRB-020 runs whose Telegram identity has no user record
  /// yet; such runs are inaccessible and never submitted (fail closed). A trigger
  /// keeps it consistent with requested_by_telegram_user_id.
  userId                    String?          @map("user_id") @db.Uuid
  /// TRB-050: the task this manual run was started from (its prompt and zone are copied
  /// into the immutable snapshot), with the task revision at admission. Null for /research.
  taskId                    String?          @map("task_id") @db.Uuid
  task                      Task?            @relation(fields: [taskId], references: [id], onDelete: Restrict)
  taskRevision              Int?             @map("task_revision")
  trigger                   RunTrigger       @default(MANUAL)
  /// SCHEDULED only: the planned occurrence (UTC) this run executes; actual times are started_at/submitted_at.
  occurrenceAt              DateTime?        @map("occurrence_at") @db.Timestamptz(3)
  scheduleEvents            ScheduleEvent[]
  /// UTC accounting periods of the admission ("YYYY-MM-DD", "YYYY-MM"); never recomputed.
  admittedDay               String?          @map("admitted_day")
  admittedMonth             String?          @map("admitted_month")
  user                      AppUser?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Destination derived from the authorized private chat of the request.
  chatId                    BigInt           @map("chat_id")
  /// Telegram update of a manual request; null for scheduled runs (TRB-070).
  sourceUpdateId            BigInt?          @unique @map("source_update_id")
  state                     ResearchRunState @default(QUEUED)
  prompt                    String
  /// Provider kind fixed at admission ("fake" or "openai"); never switched silently.
  providerKind              String           @map("provider_kind")
  /// Immutable request snapshot: policy version, model, bounds, context dates.
  requestSnapshot           Json             @map("request_snapshot")

  submissionState    SubmissionState @default(NOT_SUBMITTED) @map("submission_state")
  submittedAt        DateTime?       @map("submitted_at") @db.Timestamptz(3)
  providerResponseId String?         @unique @map("provider_response_id")
  providerStatus     String?         @map("provider_status")
  providerModel      String?         @map("provider_model")

  leaseOwner   String?   @map("lease_owner")
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz(3)
  fencingToken Int       @default(0) @map("fencing_token")

  startedAt                 DateTime?               @map("started_at") @db.Timestamptz(3)
  completedAt               DateTime?               @map("completed_at") @db.Timestamptz(3)
  outcome                   ResearchOutcome?
  /// Original provider text, before rendering.
  reportText                String?                 @map("report_text")
  /// Provider url_citation annotations with resolved code-point offsets.
  citations                 Json?
  /// URLs reported as consulted by web_search_call actions.
  sources                   Json?
  warnings                  Json?
  usage                     Json?
  /// Historical meaning (unchanged): number of web_search_call output items in the
  /// final known snapshot (maximum over snapshots). An observation, not a count of
  /// executed or billable searches.
  toolCallCount             Int?                    @map("tool_call_count")
  /// Null: per-item tool telemetry was not recorded for this run (it predates it).
  /// 1: observed items are recorded in research_tool_item during execution.
  toolTelemetryVersion      Int?                    @map("tool_telemetry_version")
  toolItems                 ResearchToolItem[]
  failureCode               String?                 @map("failure_code")
  /// Set only by operator reconciliation of an UNCERTAIN run; the run keeps its
  /// state, failure code, response ID and usage as evidence.
  reconciledAt              DateTime?               @map("reconciled_at") @db.Timestamptz(3)
  reconciliation            ResearchReconciliation?
  /// Durable suspension decision (TRB-030): set when the owner is suspended while the
  /// run is queued or running. Automatic deliveries for this run are created
  /// SUPPRESSED and a running request gets a cancellation request. Never cleared,
  /// so reactivation does not release this run's results; /result still works.
  deliverySuppressedAt      DateTime?               @map("delivery_suppressed_at") @db.Timestamptz(3)
  /// Why delivery_suppressed_at was set: USER_SUSPENDED (also requests provider
  /// cancellation of a running request), TASK_DELETED or CHAT_BLOCKED (delivery only).
  deliverySuppressionReason String?                 @map("delivery_suppression_reason")
  /// One reservation per provider submission attempt (TRB-060); attempt 1 is created at admission.
  reservations              BudgetReservation[]
  /// TRB-060: provider submission attempts. The run's own submission, response,
  /// usage and lease fields describe its current attempt.
  attempts                  ResearchAttempt[]
  /// Number of the current submission attempt (1 unless a retry was authorized).
  currentAttemptNo          Int                     @default(1) @map("current_attempt_no")
  /// QUEUED for a retry: not claimable before this instant.
  nextAttemptAt             DateTime?               @map("next_attempt_at") @db.Timestamptz(3)
  outboxEvents              OutboxEvent[]

  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries Delivery[]

  @@index([state, createdAt])
  @@index([userId, createdAt])
  @@map("research_run")
}

enum DeliveryKind {
  STATUS
  REPORT
  RESEND
  /// Carries an invitation link; the token is derived at send time, never stored.
  INVITATION
}

enum DeliveryState {
  PENDING
  SENDING
  SENT
  RETRYABLE_FAILURE
  UNKNOWN
  PERMANENT_FAILURE
  /// Not sent because the run's owner is suspended (terminal).
  SUPPRESSED
}

enum DeliveryPartState {
  PENDING
  SENDING
  SENT
  UNKNOWN
  FAILED
}

/// TRB-080: a part is a text message or a full-text document (report fallback).
enum DeliveryPartKind {
  MESSAGE
  DOCUMENT
}

model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  /// TRB-080: creation order; deliveries to one chat are sent in this order.
  seq           BigInt         @unique @default(autoincrement())
  runId         String?        @map("run_id") @db.Uuid
  run           ResearchRun?   @relation(fields: [runId], references: [id])
  kind          DeliveryKind
  chatId        BigInt         @map("chat_id")
  state         DeliveryState  @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseOwner    String?        @map("lease_owner")
  leaseUntil    DateTime?      @map("lease_until") @db.Timestamptz(3)
  fencingToken  Int            @default(0) @map("fencing_token")
  lastErrorCode String?        @map("last_error_code")
  /// Durable suppression decision: once set the delivery never sends another part
  /// (a part already handed to Telegram may still complete). Never cleared.
  suppressedAt  DateTime?      @map("suppressed_at") @db.Timestamptz(3)
  /// Set only for kind INVITATION.
  invitationId  String?        @map("invitation_id") @db.Uuid
  invitation    Invitation?    @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  parts         DeliveryPart[]
  /// TRB-080: durable wake-ups published to the delivery queue (docs/DELIVERY.md).
  events        DeliveryEvent[]

  @@index([state, nextAttemptAt])
  @@map("delivery")
}

/// Immutable rendered payload; only state and Telegram metadata change (a trigger
/// rejects payload changes, TRB-080).
model DeliveryPart {
  deliveryId        String            @map("delivery_id") @db.Uuid
  delivery          Delivery          @relation(fields: [deliveryId], references: [id])
  ordinal           Int
  kind              DeliveryPartKind  @default(MESSAGE)
  /// MESSAGE: the message HTML. DOCUMENT: the caption HTML.
  html              String
  /// DOCUMENT only: generated file name and the complete UTF-8 file text.
  fileName          String?           @map("file_name")
  fileContent       String?           @map("file_content")
  /// Telegram inline keyboard (callback buttons only), or null.
  replyMarkup       Json?             @map("reply_markup")
  contentHash       String            @map("content_hash")
  state             DeliveryPartState @default(PENDING)
  telegramMessageId BigInt?           @map("telegram_message_id")
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(3)
  /// Send intent: when the part was marked SENDING, right before the Telegram call.
  sendStartedAt     DateTime?         @map("send_started_at") @db.Timestamptz(3)
  /// Last classified failure of this part (Telegram error code), if any.
  errorCode         String?           @map("error_code")

  @@id([deliveryId, ordinal])
  @@map("delivery_part")
}

/// Durable request to inspect and advance a delivery (TRB-080, docs/DELIVERY.md):
/// the delivery dispatcher publishes due events to the delivery queue and sets
/// dispatched_at in the same transaction; the event ID is the pg-boss job ID.
/// At most one undispatched event per delivery (partial unique index).
model DeliveryEvent {
  id           String    @id @default(uuid()) @db.Uuid
  deliveryId   String    @map("delivery_id") @db.Uuid
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  reason       String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Not published before this instant (Retry-After, backoff).
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)

  @@index([deliveryId])
  @@map("delivery_event")
}

enum ReconciliationResolution {
  /// Operator verified at the provider that the request reached a terminal state.
  PROVIDER_CONFIRMED_TERMINAL
  /// Operator verified that no provider request exists for this run.
  PROVIDER_REQUEST_ABSENT
  /// Operator could not verify and explicitly accepts the possible cost.
  OPERATOR_ACCEPTED_RISK
}

/// Append-only audit record of an operator reconciliation (TRB-020 fail-closed policy).
/// UPDATE and DELETE are rejected by a trigger.
model ResearchReconciliation {
  id         String                   @id @default(uuid()) @db.Uuid
  runId      String                   @unique @map("run_id") @db.Uuid
  run        ResearchRun              @relation(fields: [runId], references: [id])
  operator   String
  resolution ReconciliationResolution
  note       String
  /// Snapshot of the run's uncertainty evidence at reconciliation time.
  evidence   Json
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("research_reconciliation")
}

/// Diagnostic record of one observed built-in tool output item (TRB-020 follow-up).
/// One row per (provider response, item); repeated observations update status and
/// action type instead of adding rows. No queries, URLs or page content.
model ResearchToolItem {
  runId          String      @map("run_id") @db.Uuid
  run            ResearchRun @relation(fields: [runId], references: [id])
  responseId     String      @map("response_id")
  /// Provider item ID, or "missing-id:<position>" when the provider omitted it.
  itemKey        String      @map("item_key")
  itemIdReported Boolean     @map("item_id_reported")
  itemType       String      @map("item_type")
  /// Latest reported status, verbatim; null when never reported.
  status         String?
  /// Latest reported action.type, verbatim; null when never reported.
  actionType     String?     @map("action_type")
  observations   Int         @default(1)
  firstSeenAt    DateTime    @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  @@id([responseId, itemKey])
  @@index([runId])
  @@map("research_tool_item")
}

// ---------------------------------------------------------------------------
// TRB-030: identity, invitations, onboarding, suspension and audit. Triggers
// and checks Prisma cannot express are added in the SQL migration.

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OnboardingState {
  AWAITING_TIME_ZONE
  COMPLETED
}

/// A Telegram user known to the bot. Identity is the immutable Telegram user ID
/// (a trigger rejects changes); usernames and display names are not stored.
model AppUser {
  id                 String              @id @default(uuid()) @db.Uuid
  telegramUserId     BigInt              @unique @map("telegram_user_id")
  /// Private chat with the bot, recorded from the user's own private messages.
  privateChatId      BigInt?             @map("private_chat_id")
  /// Mirror of ADMIN_TELEGRAM_IDS, which is authoritative (synchronized at startup
  /// and on each update from the user). Invitations never grant ADMIN.
  role               UserRole            @default(MEMBER)
  status             UserStatus          @default(ACTIVE)
  onboardingState    OnboardingState     @default(AWAITING_TIME_ZONE) @map("onboarding_state")
  /// Confirmed IANA time zone; required once onboarding is COMPLETED.
  timeZone           String?             @map("time_zone")
  /// Incremented on every onboarding or lifecycle change; callbacks carry it, so stale buttons do nothing.
  revision           Int                 @default(0)
  /// Set when the user redeemed an invitation. Members need it; administrators do not.
  invitedAt          DateTime?           @map("invited_at") @db.Timestamptz(3)
  onboardedAt        DateTime?           @map("onboarded_at") @db.Timestamptz(3)
  suspendedAt        DateTime?           @map("suspended_at") @db.Timestamptz(3)
  /// TRB-080: Telegram confirmed the private chat cannot receive messages (bot
  /// blocked, account deactivated). Automatic research is paused; cleared only
  /// when the user writes to the bot again (docs/DELIVERY.md).
  chatBlockedAt      DateTime?           @map("chat_blocked_at") @db.Timestamptz(3)
  chatBlockReason    String?             @map("chat_block_reason")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  runs               ResearchRun[]
  invitationsCreated Invitation[]        @relation("InvitationCreator")
  invitationRedeemed Invitation?         @relation("InvitationRedeemer")
  auditAsActor       AuditEvent[]        @relation("AuditActor")
  auditAsSubject     AuditEvent[]        @relation("AuditSubject")
  tasks              Task[]
  taskDraft          TaskDraft?
  reservations       BudgetReservation[]
  ledgerEntries      UsageLedger[]
  scheduleEvents     ScheduleEvent[]

  @@map("app_user")
}

/// Single-use invitation. Only the SHA-256 hash of the token is stored; the token
/// itself is derived at send time (docs/IDENTITY.md).
model Invitation {
  id               String       @id @db.Uuid
  tokenHash        String       @unique @map("token_hash")
  createdByUserId  String       @map("created_by_user_id") @db.Uuid
  createdBy        AppUser      @relation("InvitationCreator", fields: [createdByUserId], references: [id])
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(3)
  redeemedByUserId String?      @unique @map("redeemed_by_user_id") @db.Uuid
  redeemedBy       AppUser?     @relation("InvitationRedeemer", fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  redeemedAt       DateTime?    @map("redeemed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveries       Delivery[]
  auditEvents      AuditEvent[]

  @@map("invitation")
}

enum AuditEventKind {
  ADMIN_GRANTED
  ADMIN_REVOKED
  INVITATION_CREATED
  INVITATION_REDEEMED
  USER_SUSPENDED
  USER_REACTIVATED
  /// TRB-080: Telegram confirmed the user's private chat is unavailable.
  DESTINATION_BLOCKED
  /// TRB-080: the user wrote to the bot again after a confirmed block.
  DESTINATION_RESTORED
}

/// Append-only access audit (UPDATE and DELETE are rejected by a trigger).
/// Holds identifiers, codes and counts only: no tokens, prompts or report content.
model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  kind          AuditEventKind
  /// Null for configuration-driven changes (administrator bootstrap).
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  actor         AppUser?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  subjectUserId String?        @map("subject_user_id") @db.Uuid
  subject       AppUser?       @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  invitationId  String?        @map("invitation_id") @db.Uuid
  invitation    Invitation?    @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  details       Json
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectUserId, createdAt])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// TRB-040: research tasks and durable creation/edit dialogs. Schedules store
// local intent (weekday, HH:mm, IANA zone); execution is added by TRB-070.

enum TaskState {
  ACTIVE
  PAUSED
  /// Soft-deleted: hidden from navigation, accepts no further actions; history is kept.
  DELETED
}

enum ScheduleKind {
  MANUAL
  DAILY
  WEEKLY
}

model Task {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  user               AppUser         @relation(fields: [userId], references: [id], onDelete: Restrict)
  name               String
  prompt             String
  scheduleKind       ScheduleKind    @map("schedule_kind")
  /// ISO weekday 1 (Monday) to 7 (Sunday); WEEKLY only.
  weekday            Int?
  /// Local wall-clock time "HH:mm" in time_zone; DAILY and WEEKLY only. Never converted to UTC.
  localTime          String?         @map("local_time")
  /// The task's own IANA zone; independent of the user's default.
  timeZone           String          @map("time_zone")
  state              TaskState       @default(ACTIVE)
  /// Incremented on every change; edits and buttons carry it (optimistic concurrency).
  revision           Int             @default(1)
  /// The draft that created it; unique, so one draft can never create two tasks.
  createdFromDraftId String?         @unique @map("created_from_draft_id") @db.Uuid
  /// Next planned occurrence (UTC) of an active daily/weekly task; null otherwise (TRB-070).
  nextRunAt          DateTime?       @map("next_run_at") @db.Timestamptz(3)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  drafts             TaskDraft[]
  runs               ResearchRun[]
  scheduleEvents     ScheduleEvent[]

  @@index([userId, state, createdAt])
  @@map("task")
}

enum DraftMode {
  CREATE
  EDIT
}

enum DraftSection {
  NAME
  PROMPT
  SCHEDULE
}

enum DraftStep {
  NAME
  PROMPT
  SCHEDULE_KIND
  WEEKDAY
  LOCAL_TIME
  TIME_ZONE
  PREVIEW
}

/// At most one open dialog per user (creation or editing). Survives restarts;
/// expires after inactivity. Values entered so far live in `data`.
model TaskDraft {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @unique @map("user_id") @db.Uuid
  user         AppUser       @relation(fields: [userId], references: [id], onDelete: Restrict)
  mode         DraftMode
  /// EDIT only: the task being edited, the section and the task revision when editing began.
  taskId       String?       @map("task_id") @db.Uuid
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  section      DraftSection?
  baseRevision Int?          @map("base_revision")
  step         DraftStep
  data         Json
  /// Incremented on every change; buttons carry it, so old buttons do nothing.
  version      Int           @default(0)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("task_draft")
}

// ---------------------------------------------------------------------------
// TRB-050: atomic admission, quotas, cost reservations, usage ledger and outbox.
// Money is integer micro-USD (BigInt). Estimates are local accounting, never a
// provider invoice.

enum RunTrigger {
  MANUAL
  /// Admitted by the scheduler for a planned occurrence (TRB-070).
  SCHEDULED
}

/// Operator-supplied pricing, registered on first use. A version label is
/// immutable: different rates under the same label are refused at admission.
model PricingVersion {
  version      String              @id
  model        String
  content      Json
  contentHash  String              @map("content_hash")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  reservations BudgetReservation[]

  @@map("pricing_version")
}

enum ReservationStatus {
  /// Admitted, provider outcome not known yet; exposure = reserved amount.
  RESERVED
  /// Ended before any provider request could exist; exposure 0.
  RELEASED
  /// Terminal with usage: exposure = token estimate + observed searches + the
  /// unverified search allowance still held (see docs/ACCOUNTING.md).
  SETTLED
  /// Cost unknown (ambiguous outcome, missing usage, unmapped model); exposure is
  /// at least the reserved amount until an operator resolves it.
  UNRESOLVED
  /// Operator recorded a confirmed amount from billing evidence; exposure = that amount.
  RESOLVED
}

/// One per provider submission attempt of an accepted live run. Status changes are conditional (idempotent) and
/// mirrored by append-only usage_ledger entries whose amounts sum to exposure.
model BudgetReservation {
  id              String            @id @default(uuid()) @db.Uuid
  runId           String            @map("run_id") @db.Uuid
  run             ResearchRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  /// The provider submission attempt this reservation funds (TRB-060); immutable.
  attemptNo       Int               @default(1) @map("attempt_no")
  userId          String            @map("user_id") @db.Uuid
  user            AppUser           @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// UTC month of admission; every later entry stays in this period.
  periodMonth     String            @map("period_month")
  status          ReservationStatus @default(RESERVED)
  reservedMicros  BigInt            @map("reserved_micros")
  /// Token cost estimate plus observed searches (SETTLED); null otherwise.
  estimatedMicros BigInt?           @map("estimated_micros")
  /// Search allowance kept because billable searches are not verified (SETTLED).
  uncertainMicros BigInt?           @map("uncertain_micros")
  /// Operator-confirmed amount (RESOLVED).
  confirmedMicros BigInt?           @map("confirmed_micros")
  /// Amount counted against budgets now.
  exposureMicros  BigInt            @map("exposure_micros")
  pricingVersion  String            @map("pricing_version")
  pricing         PricingVersion    @relation(fields: [pricingVersion], references: [version], onDelete: Restrict)
  /// Reservation policy version and every input of the reservation (rates, allowances).
  policyVersion   String            @map("policy_version")
  policy          Json
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  ledger          UsageLedger[]

  @@unique([runId, attemptNo])
  @@index([runId])
  @@index([userId, periodMonth])
  @@index([periodMonth])
  @@map("budget_reservation")
}

enum LedgerKind {
  RESERVE
  RELEASE
  SETTLE
  UNRESOLVED
  OVERRUN
  RESOLVE
}

/// Append-only accounting evidence (UPDATE and DELETE are rejected by a trigger).
/// `amount_micros` is the change of exposure; `operation_key` makes replays no-ops.
model UsageLedger {
  id                  String            @id @default(uuid()) @db.Uuid
  reservationId       String            @map("reservation_id") @db.Uuid
  reservation         BudgetReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  runId               String            @map("run_id") @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  user                AppUser           @relation(fields: [userId], references: [id], onDelete: Restrict)
  periodMonth         String            @map("period_month")
  kind                LedgerKind
  amountMicros        BigInt            @map("amount_micros")
  exposureAfterMicros BigInt            @map("exposure_after_micros")
  operationKey        String            @unique @map("operation_key")
  /// Raw usage, rates, counts and notes that explain the amount.
  basis               Json
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([reservationId])
  @@map("usage_ledger")
}

/// Durable request to inspect and advance a run (docs/QUEUE.md). RESEARCH_EXECUTE
/// is written by admission and is the run's admission evidence; RESEARCH_WAKE
/// re-wakes a run (deferral, retry, recovery). The dispatcher publishes due events
/// to pg-boss and sets dispatched_at in the same transaction. At most one
/// undispatched event per run (partial unique index).
model OutboxEvent {
  id           String      @id @default(uuid()) @db.Uuid
  operationKey String      @unique @map("operation_key")
  type         String
  runId        String      @map("run_id") @db.Uuid
  run          ResearchRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  payload      Json
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Not published before this instant (deferred wake-ups).
  availableAt  DateTime    @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt DateTime?   @map("dispatched_at") @db.Timestamptz(3)
  cancelledAt  DateTime?   @map("cancelled_at") @db.Timestamptz(3)

  @@index([runId])
  @@map("outbox_event")
}

// ---------------------------------------------------------------------------
// TRB-060: provider submission attempts.

/// How a provider submission attempt ended; null while it is open.
enum AttemptOutcome {
  /// The provider reported a terminal status for the response.
  PROVIDER_TERMINAL
  /// The provider refused the request (HTTP 4xx); nothing was started or billed.
  NOT_ACCEPTED
  /// The request may still exist or bill (unknown submission, unconfirmed cancellation).
  UNCERTAIN
}

/// One provider submission of a run, created with the submission intent before
/// the call. Polling or a queue redelivery resumes the same attempt; only a new
/// provider submission creates another one (with its own reservation).
model ResearchAttempt {
  id                 String          @id @default(uuid()) @db.Uuid
  runId              String          @map("run_id") @db.Uuid
  run                ResearchRun     @relation(fields: [runId], references: [id], onDelete: Restrict)
  attemptNo          Int             @map("attempt_no")
  submissionState    SubmissionState @map("submission_state")
  outcome            AttemptOutcome?
  /// Run fencing token of the worker that recorded the submission intent.
  fencingToken       Int             @map("fencing_token")
  workerId           String?         @map("worker_id")
  submittedAt        DateTime?       @map("submitted_at") @db.Timestamptz(3)
  providerResponseId String?         @unique @map("provider_response_id")
  providerStatus     String?         @map("provider_status")
  providerModel      String?         @map("provider_model")
  usage              Json?
  toolCallCount      Int?            @map("tool_call_count")
  failureCode        String?         @map("failure_code")
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([runId, attemptNo])
  @@map("research_attempt")
}

// ---------------------------------------------------------------------------
// TRB-070: persistent scheduling.

/// What happened to one planned occurrence of a task.
enum ScheduleDisposition {
  /// Admitted through the normal admission path (run_id).
  ADMITTED
  /// The task already had a QUEUED or RUNNING run (run_id references it; nothing new was created).
  SKIPPED_OVERLAP
  /// Admission refused it: quota, budget, configuration, access (reason).
  SKIPPED_DENIED
  /// Missed during downtime: superseded by a later occurrence, or older than the catch-up window.
  SKIPPED_MISSED
}

/// Operational history of planned occurrences: one row per (task, occurrence).
/// A SKIPPED_MISSED row may stand for a range (occurrence_at … range_end, skipped_count).
model ScheduleEvent {
  id              String              @id @default(uuid()) @db.Uuid
  taskId          String              @map("task_id") @db.Uuid
  task            Task                @relation(fields: [taskId], references: [id], onDelete: Restrict)
  userId          String              @map("user_id") @db.Uuid
  user            AppUser             @relation(fields: [userId], references: [id], onDelete: Restrict)
  occurrenceAt    DateTime            @map("occurrence_at") @db.Timestamptz(3)
  disposition     ScheduleDisposition
  reason          String
  runId           String?             @map("run_id") @db.Uuid
  run             ResearchRun?        @relation(fields: [runId], references: [id], onDelete: Restrict)
  taskRevision    Int                 @map("task_revision")
  /// Admitted later than the on-time grace after its occurrence.
  catchUp         Boolean             @default(false) @map("catch_up")
  latenessSeconds Int                 @default(0) @map("lateness_seconds")
  /// SKIPPED_MISSED ranges: the last skipped occurrence and how many (null when beyond the counting bound).
  rangeEnd        DateTime?           @map("range_end") @db.Timestamptz(3)
  skippedCount    Int?                @map("skipped_count")
  /// The owner was told (denials are reported once per consecutive reason).
  notified        Boolean             @default(false)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([taskId, occurrenceAt])
  @@index([taskId, createdAt])
  @@map("schedule_event")
}
